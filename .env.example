APP_NAME=Juzaweb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_ALLOW_PUBLIC_WELCOME=false

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=juzaweb
DB_USERNAME=root
DB_PASSWORD=
DB_SQLITE_DATABASE=database/database.sqlite
DB_FALLBACK_TO_SQLITE=true

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT_URL_S3=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_FUNCTION_HELLO_BASE_URL=
NEON_AI_GATEWAY_URL=
NEON_AI_GATEWAY_TOKEN=
AWS_USE_PATH_STYLE_ENDPOINT=true

S3_CLOUD_KEY_ID=
S3_CLOUD_SECRET=
S3_CLOUD_REGION=
S3_CLOUD_BUCKET=
S3_CLOUD_ENDPOINT=
S3_CLOUD_URL=

S3_CLOUD_STREAM_ROUTE=false
S3_CLOUD_WRITE_ENDPOINT=

# Cloud Upload Configuration
CLOUD_UPLOAD_ENABLED=false
CLOUD_DISK=cloud
